{
  "name": "rhfiles-tests",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node scripts/automation-bindings.mjs && node --test scripts/tests/*.test.mjs android/web/tests/*.test.cjs android/web/tests/format.test.js",
    "test:android-preview": "node android/web/tests/media-check.mjs && node android/web/tests/preview-continuous-check.mjs",
    "api": "node scripts/rhfiles-api.mjs",
    "test:automation-ui": "node scripts/testing/automation-ui-check.mjs",
    "test:android-sort-tasks": "node android/web/tests/sort-task-check.mjs",
    "test:mutations": "node scripts/testing/mutation-check.mjs",
    "test:gui": "node scripts/testing/gui-check.mjs",
    "test:pdf": "node scripts/markdown-pdf-regression.mjs",
    "test:e2e": "node --test --test-concurrency=1 scripts/e2e/*.test.mjs"
  },
  "devDependencies": {
    "acorn": "8.18.0",
    "dompurify": "3.4.17",
    "fast-check": "4.10.2",
    "marked": "18.1.3",
    "pdfjs-dist": "6.5.438",
    "playwright-core": "1.65.0"
  }
}
